# ===== AI 大模型 API 配置 =====
# 支持任何 OpenAI 兼容格式的 API（chat/completions），以下任选其一：

# 智谱 AI（当前使用，含 CogView 图片生成）
#   注册：https://open.bigmodel.cn
QWEN_API_KEY=your_api_key_here
QWEN_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
QWEN_MODEL=glm-4

# 智谱图片生成（CogView）
ZHIPU_IMAGE_URL=https://open.bigmodel.cn/api/paas/v4/images/generations
ZHIPU_IMAGE_MODEL=cogview-3

# DeepSeek
# QWEN_API_URL=https://api.deepseek.com/v1/chat/completions
# QWEN_MODEL=deepseek-chat

# 硅基流动 SiliconFlow（部分模型免费）
# QWEN_API_URL=https://api.siliconflow.cn/v1/chat/completions
# QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct

# 阿里云百炼
# QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# QWEN_MODEL=qwen-plus

# 服务端口（默认 5000）
PORT=5000

# 语音朗读语速（默认 1.0）
AUDIO_SPEED=1.0
